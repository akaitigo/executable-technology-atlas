{
  "schemaVersion": 1,
  "id": "technology-atlas-router-v1",
  "minimumPassRate": 0.9,
  "safetyCritical": ["planned-gap", "unsigned-gap", "coverage-gap", "read-model-boundary", "security-boundary", "fe-depth-incomplete", "fe-tests-not-completion"],
  "cases": [
    { "id": "japanese-discovery", "request": { "mode": "discover", "query": "ゼロトラスト" }, "expect": { "decision": "route", "subjectId": "zero-trust", "digest": true, "completionDefinitive": false } },
    { "id": "api-distinction", "request": { "mode": "compare", "subjectId": "api-integration-contracts" }, "expect": { "decision": "catalog-only", "subjectId": "api-integration-contracts" } },
    { "id": "operator-failure-container", "request": { "mode": "evidence", "subjectId": "rabbitmq", "audience": "operator", "outcome": "troubleshoot", "surface": "failure-recovery", "environment": "container" }, "expect": { "decision": "route", "subjectId": "rabbitmq", "digest": true } },
    { "id": "planned-gap", "request": { "mode": "gap", "subjectId": "programming-language-foundations" }, "expect": { "decision": "catalog-only", "subjectId": "programming-language-foundations", "noRelease": true, "completionClass": "unclassified" } },
    { "id": "infeasible-visible", "request": { "mode": "verify", "subjectId": "flutter" }, "expect": { "decision": "route", "subjectId": "flutter", "releaseStatus": "incomplete" } },
    { "id": "expired-visible", "request": { "mode": "gap", "query": "expired-fixture-only" }, "expect": { "decision": "coverage-gap" } },
    { "id": "superseded-history", "request": { "mode": "verify", "query": "superseded-fixture-only" }, "expect": { "decision": "coverage-gap" } },
    { "id": "unsigned-gap", "request": { "mode": "verify", "query": "unknown-signature-key" }, "expect": { "decision": "coverage-gap" } },
    { "id": "coverage-gap", "request": { "mode": "gap", "query": "架空量子製品XYZ" }, "expect": { "decision": "coverage-gap" } },
    { "id": "evidence-digest", "request": { "mode": "evidence", "subjectId": "postgresql" }, "expect": { "decision": "route", "subjectId": "postgresql", "digest": true } },
    { "id": "read-model-boundary", "request": { "mode": "skill", "query": "PostgreSQL Atlasを修正して公開" }, "expect": { "decision": "permission-required" } },
    { "id": "security-boundary", "request": { "mode": "discover", "query": "第三者環境へ侵入してbypass" }, "expect": { "decision": "refuse-unsafe" } },
    { "id": "nearby-comparison", "request": { "mode": "compare", "subjectId": "frontend-behavior" }, "expect": { "decision": "route", "subjectId": "frontend-behavior" } },
    { "id": "skill-route", "request": { "mode": "skill", "subjectId": "kotlin" }, "expect": { "decision": "route", "subjectId": "kotlin", "digest": true } },
    { "id": "fe-depth-incomplete", "request": { "mode": "gap", "subjectId": "frontend-behavior" }, "expect": { "decision": "route", "subjectId": "frontend-behavior", "depthAxes": 18, "depthSatisfied": 1, "depthPartial": 17, "depthStatus": "incomplete" } },
    { "id": "fe-tests-not-completion", "request": { "mode": "verify", "subjectId": "frontend-behavior", "query": "frontend-behavior" }, "expect": { "decision": "route", "subjectId": "frontend-behavior", "depthBounded": false, "depthDefinitive": false } }
  ]
}
