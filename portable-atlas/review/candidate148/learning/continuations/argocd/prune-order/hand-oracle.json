{
  "schema": 1,
  "method": "模型・validator実装前に手で固定。元wave -3,1,8の対称交換は8,1,-3。各ケースの停止箇所と未着手を個別に列挙。模型から期待値を生成していない。",
  "cases": {
    "apply-ascending": {
      "declared_order": ["low", "mid", "high"],
      "effective_waves": {"low": -3, "mid": 1, "high": 8},
      "batches": [{"wave": -3, "prune": [], "apply": ["low"]}, {"wave": 1, "prune": [], "apply": ["mid"]}, {"wave": 8, "prune": [], "apply": ["high"]}],
      "started": ["low", "mid", "high"],
      "results": {"low": {"result": "Synced", "observation": "ready"}, "mid": {"result": "Synced", "observation": "ready"}, "high": {"result": "Synced", "observation": "unobserved"}},
      "unstarted": [],
      "stop": {"reason": "plan-consumed", "wave": 8}
    },
    "prune-descending": {
      "declared_order": ["low", "mid", "high"],
      "effective_waves": {"low": 8, "mid": 1, "high": -3},
      "batches": [{"wave": -3, "prune": ["high"], "apply": []}, {"wave": 1, "prune": ["mid"], "apply": []}, {"wave": 8, "prune": ["low"], "apply": []}],
      "started": ["high", "mid", "low"],
      "results": {"high": {"result": "Pruned", "observation": "absent"}, "mid": {"result": "Pruned", "observation": "absent"}, "low": {"result": "Pruned", "observation": "unobserved"}},
      "unstarted": [],
      "stop": {"reason": "plan-consumed", "wave": 8}
    },
    "prune-waiting": {
      "declared_order": ["low", "mid", "high"],
      "effective_waves": {"low": 8, "mid": 1, "high": -3},
      "batches": [{"wave": -3, "prune": ["high"], "apply": []}, {"wave": 1, "prune": ["mid"], "apply": []}, {"wave": 8, "prune": ["low"], "apply": []}],
      "started": ["high"],
      "results": {"high": {"result": "Pruned", "observation": "terminating"}},
      "unstarted": ["mid", "low"],
      "stop": {"reason": "next-reconciliation-waits-for-deletion", "wave": -3}
    },
    "prune-failed": {
      "declared_order": ["low", "mid", "high"],
      "effective_waves": {"low": 8, "mid": 1, "high": -3},
      "batches": [{"wave": -3, "prune": ["high"], "apply": []}, {"wave": 1, "prune": ["mid"], "apply": []}, {"wave": 8, "prune": ["low"], "apply": []}],
      "started": ["high", "mid"],
      "results": {"high": {"result": "Pruned", "observation": "absent"}, "mid": {"result": "SyncFailed", "observation": "unobserved"}},
      "unstarted": ["low"],
      "stop": {"reason": "runTasks-prune-failed", "wave": 1}
    },
    "mixed-same-wave-failed": {
      "declared_order": ["new", "old", "later"],
      "effective_waves": {"old": 0, "new": 0, "later": 2},
      "batches": [{"wave": 0, "prune": ["old"], "apply": ["new"]}, {"wave": 2, "prune": [], "apply": ["later"]}],
      "started": ["old"],
      "results": {"old": {"result": "SyncFailed", "observation": "unobserved"}},
      "unstarted": ["new", "later"],
      "stop": {"reason": "runTasks-prune-failed", "wave": 0}
    }
  }
}
