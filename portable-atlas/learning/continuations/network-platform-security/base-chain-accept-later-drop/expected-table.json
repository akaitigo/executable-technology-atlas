{
  "oracle": "literal full traces fixed before evaluator; no evaluator import",
  "rows": [
    {
      "id": "trusted-22",
      "label": "trusted tcp/22: accept後drop",
      "input_json": "{\"packet\":{\"source\":\"10.0.0.1\",\"protocol\":\"tcp\",\"dport\":22},\"chains\":[{\"id\":\"source\",\"hook\":\"input\",\"priority\":0,\"enabled\":true,\"verdict\":\"accept\",\"policy\":\"drop\"},{\"id\":\"service\",\"hook\":\"input\",\"priority\":10,\"enabled\":true,\"verdict\":\"drop\",\"policy\":\"accept\"}]}",
      "expected": {
        "status": "observed",
        "packet": {
          "source": "10.0.0.1",
          "protocol": "tcp",
          "dport": 22
        },
        "ordered_chains": [
          "source",
          "service"
        ],
        "normal": {
          "final": "drop",
          "trace": [
            "chain source priority=0",
            "rule trusted-source match=true verdict=accept",
            "accept: next base chain",
            "chain service priority=10",
            "rule tcp-dport-22 match=true verdict=drop",
            "drop: stop ruleset",
            "final drop"
          ]
        },
        "faulty": {
          "final": "accept",
          "trace": [
            "chain source priority=0",
            "rule trusted-source match=true verdict=accept",
            "BUG accept: stop ruleset",
            "final accept"
          ]
        }
      }
    },
