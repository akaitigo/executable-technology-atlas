{
  "scope": "synthetic SQLite fixture, fixed sequential schedule, two connections; not an actual parallel race",
  "check_transaction": "reader BEGIN / SELECT tenant / COMMIT ends before writer mutation",
  "mutation_transaction": "writer BEGIN IMMEDIATE / UPDATE tenant,payload,revision / COMMIT",
  "read_transaction": "separate reader BEGIN / SELECT with tenant condition or ID-only / COMMIT or ROLLBACK",
  "normal": "precheck is diagnostic only; current tenant predicate authorizes payload retrieval in one SELECT",
  "faulty": "old check allowed then ID-only SELECT, else skip",
