    },
    {
      "caseId": "historical-output-rebound-into-run",
      "mutation": "add-historical-run-output",
      "expectedDiagnostic": "historical output rerun rebinding: public/data/index/76090e9b725c469db2cfbe02a8c5f3ab8874b6422cba88d37bd7bec6e7aed3b0.json"
