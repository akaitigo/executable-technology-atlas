      "expectedDiagnostic": "content-addressed-index-policy-weakened"
    },
    {
      "caseId": "digest-only-rebinding-enabled",
      "mutation": "allow-digest-only-rebinding",
      "expectedDiagnostic": "content-addressed-index-policy-weakened"
    },
    {
      "caseId": "graph-first-refresh-allowed",
      "mutation": "disable-graph-refresh-after-import",
      "expectedDiagnostic": "content-addressed-index-policy-weakened"
    },
    {
      "caseId": "shared-target-replacement",
      "mutation": "shared-target",
      "expectedDiagnostic": "content-addressed-index-shared-target"
    },
    {
      "caseId": "append-only-history-broken",
      "mutation": "drop-old-preserved",
      "expectedDiagnostic": "content-addressed-index-not-append-only"
