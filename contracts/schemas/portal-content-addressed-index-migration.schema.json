{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.example.invalid/schemas/portal-content-addressed-index-migration.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "current", "preservedPaths", "policy", "replacements"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "const": "portal-content-addressed-index-migration" },
    "current": { "$ref": "#/$defs/indexRef" },
    "preservedPaths": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^public/data/index/[a-f0-9]{64}\\.json$" }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["appendOnlyHistory", "oneToOneNonShared", "allowOldIndexDeletion", "graphRefreshAfterImport", "digestOnlyRebinding"],
      "properties": {
        "appendOnlyHistory": { "const": true },
        "oneToOneNonShared": { "const": true },
        "allowOldIndexDeletion": { "const": false },
        "graphRefreshAfterImport": { "const": true },
        "digestOnlyRebinding": { "const": false }
      }
    },
    "replacements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "replacementMode", "reason", "evidence"],
        "properties": {
          "from": { "$ref": "#/$defs/indexRef" },
          "to": { "$ref": "#/$defs/indexRef" },
          "replacementMode": { "const": "one-to-one-non-shared" },
          "reason": { "type": "string", "minLength": 20 },
          "evidence": {
            "type": "array",
            "minItems": 3,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "indexRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "pathDigest", "artifactDigest", "payloadDigest"],
      "properties": {
        "path": { "type": "string", "pattern": "^public/data/index/[a-f0-9]{64}\\.json$" },
        "pathDigest": { "$ref": "#/$defs/sha256" },
        "artifactDigest": { "$ref": "#/$defs/sha256" },
        "payloadDigest": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
