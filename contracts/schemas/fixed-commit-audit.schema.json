{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/akaitigo/executable-technology-atlas/schemas/fixed-commit-audit.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "attestation", "signature", "payload"],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "portal-fixed-commit-audit"},
    "attestation": {
      "type": "object", "additionalProperties": false,
      "required": ["digest", "observedAt"],
      "properties": {
        "digest": {"$ref": "#/$defs/sha256"},
        "observedAt": {"type": "string", "format": "date-time"}
      }
    },
    "signature": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "keyId", "value", "identity"],
      "properties": {
        "algorithm": {"const": "Ed25519"},
        "keyId": {"type": "string", "minLength": 1},
        "value": {"type": "string", "minLength": 20},
        "identity": {"const": "portal-fixture-observation-only"}
      }
    },
    "payload": {
      "type": "object", "additionalProperties": false,
      "required": ["subjectId", "atlasId", "repository", "sourceCommit", "sourceTree", "sourceMode", "releaseBoundary", "manifest", "core", "artifactDigests", "gaps", "readOnly", "autoPromotion"],
      "properties": {
        "subjectId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "atlasId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "repository": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "sourceCommit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "sourceTree": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "sourceMode": {"const": "fixed-clean-commit"},
        "releaseBoundary": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "tag", "signedManifest", "publicTrustKey", "definitiveCertificate"],
          "properties": {
            "status": {"const": "unpublished-fixed-commit"},
            "tag": {"type": ["string", "null"]},
            "signedManifest": {"const": false},
            "publicTrustKey": {"const": false},
            "definitiveCertificate": {"const": false}
          }
        },
        "manifest": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "completionClass", "targets", "openRequired", "claims", "evidence"],
          "properties": {
            "status": {"const": "incomplete"},
            "completionClass": {"const": "incomplete"},
            "targets": {"type": "integer", "minimum": 0},
            "openRequired": {"type": "integer", "minimum": 1},
            "claims": {"type": "integer", "minimum": 0},
            "evidence": {"type": "integer", "minimum": 0}
          }
        },
        "core": {
          "type": "object", "additionalProperties": false,
          "required": ["commit", "audit", "evidenceDependency", "authorityExtraction", "authorityBody", "authorityReview", "definitive"],
          "properties": {
            "commit": {"const": "072d7ca77981f51754e824d70c6d4ecd55ea67e5"},
            "audit": {"$ref": "#/$defs/gate"},
            "evidenceDependency": {"$ref": "#/$defs/gate"},
            "authorityExtraction": {"$ref": "#/$defs/gate"},
            "authorityBody": {"$ref": "#/$defs/gate"},
            "authorityReview": {"$ref": "#/$defs/gate"},
            "definitive": {"$ref": "#/$defs/gate"}
          }
        },
        "artifactDigests": {
          "type": "array", "minItems": 5, "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["path", "digest"],
            "properties": {"path": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/sha256"}}
          }
        },
        "gaps": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "status", "detail", "count"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
              "status": {"const": "open"},
              "detail": {"type": "string", "minLength": 5},
              "count": {"type": "integer", "minimum": 1}
            }
          }
        },
        "readOnly": {"const": true},
        "autoPromotion": {"const": false}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "gate": {
      "type": "object", "additionalProperties": false,
      "required": ["command", "result", "summary", "diagnostics"],
      "properties": {
        "command": {"type": "string", "minLength": 3},
        "result": {"enum": ["pass", "fail"]},
        "summary": {"type": "object"},
        "diagnostics": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
