{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/akaitigo/executable-technology-atlas/contracts/schemas/portal-distribution-gap-index.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "id", "atlasId", "scope", "status", "source", "summary", "instances", "boundary"],
  "properties": {
    "schemaVersion": { "const": 1 }, "id": { "const": "portal-subject-distribution-gap-index" }, "atlasId": { "const": "executable-technology-atlas" },
    "scope": { "const": "97-subject-open-distribution-gap-instances" }, "status": { "const": "open" },
    "source": {
      "type": "object", "additionalProperties": false, "required": ["path", "digest", "indexPath", "indexDigest"],
      "properties": { "path": { "const": "evidence/portal-distribution-readiness.json" }, "digest": { "$ref": "#/$defs/sha256" }, "indexPath": { "const": "app/data/index.generated.json" }, "indexDigest": { "$ref": "#/$defs/sha256" } }
    },
    "summary": {
      "type": "object", "additionalProperties": false, "required": ["subjects", "openInstances", "closedInstances", "blockerTypes", "gapCounts"],
      "properties": {
        "subjects": { "const": 97 }, "openInstances": { "type": "integer", "minimum": 1 }, "closedInstances": { "const": 0 }, "blockerTypes": { "type": "integer", "minimum": 1 },
        "gapCounts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "object", "additionalProperties": false, "required": ["blockerId", "openInstances"], "properties": { "blockerId": { "type": "string", "minLength": 1 }, "openInstances": { "type": "integer", "minimum": 1, "maximum": 97 } } } }
      }
    },
    "instances": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/instance" } },
    "boundary": {
      "type": "object", "additionalProperties": false, "required": ["readOnly", "autoClose", "aggregateReplacement", "rawCountsAreCompletion", "distributionStatus", "distributionGapEffect", "completionEffect"],
      "properties": { "readOnly": { "const": true }, "autoClose": { "const": false }, "aggregateReplacement": { "const": false }, "rawCountsAreCompletion": { "const": false }, "distributionStatus": { "const": "not-established" }, "distributionGapEffect": { "const": "none" }, "completionEffect": { "const": "none" } }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "instance": {
      "type": "object", "additionalProperties": false, "required": ["id", "subjectId", "repository", "blockerId", "status", "source", "closureEvidence", "distributionEffect", "completionEffect"],
      "properties": {
        "id": { "type": "string", "pattern": "^distribution-gap:[a-z0-9-]+:[a-z0-9-]+$" }, "subjectId": { "type": "string", "minLength": 1 }, "repository": { "type": "string", "minLength": 1 }, "blockerId": { "type": "string", "minLength": 1 }, "status": { "const": "open" },
        "source": { "type": "object", "additionalProperties": false, "required": ["path", "subjectOrdinal", "blockerOrdinal"], "properties": { "path": { "const": "evidence/portal-distribution-readiness.json" }, "subjectOrdinal": { "type": "integer", "minimum": 0, "maximum": 96 }, "blockerOrdinal": { "type": "integer", "minimum": 0 } } },
        "closureEvidence": { "type": "array", "maxItems": 0 }, "distributionEffect": { "const": "none" }, "completionEffect": { "const": "none" }
      }
    }
  }
}
