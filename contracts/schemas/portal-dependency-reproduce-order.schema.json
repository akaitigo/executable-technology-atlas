{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.example.invalid/schemas/portal-dependency-reproduce-order.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "entrypoint", "reportRecordScripts", "validationScripts", "importAndIndexScripts", "postImportScripts", "graphCheck"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "const": "portal-dependency-reproduce-order" },
    "entrypoint": { "const": "node scripts/refresh-portal-dependency-graph.mjs --record" },
    "reportRecordScripts": { "$ref": "#/$defs/scriptList" },
    "validationScripts": { "$ref": "#/$defs/scriptList" },
    "importAndIndexScripts": { "$ref": "#/$defs/scriptList" },
    "postImportScripts": { "$ref": "#/$defs/scriptList" },
    "graphCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["auditBeforeWrite", "digestOnlyClosure", "graphFirstRefresh", "sameRunCurrentProofRequired"],
      "properties": {
        "auditBeforeWrite": { "const": true },
        "digestOnlyClosure": { "const": false },
        "graphFirstRefresh": { "const": false },
        "sameRunCurrentProofRequired": { "const": true }
      }
    }
  },
  "$defs": {
    "scriptList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9:-]*$"
      }
    }
  }
}
