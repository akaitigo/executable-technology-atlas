{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/akaitigo/executable-technology-atlas/contracts/schemas/portal-ci-checkpoint-readiness.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "status",
    "classification",
    "source",
    "observed",
    "summary",
    "prerequisites",
    "boundary"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "const": "portal-ci-checkpoint-readiness"
    },
    "status": {
      "const": "blocked"
    },
    "classification": {
      "const": "portal-integration-checkpoint-readiness-only"
    },
    "source": {
      "type": "object",
      "minProperties": 6,
      "maxProperties": 6,
      "additionalProperties": {
        "$ref": "#/$defs/source"
      }
    },
    "observed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "git",
        "workflow",
        "signingPolicy",
        "subjectAggregation",
        "distribution",
        "root",
        "dependencyGraph",
        "ci"
      ],
      "properties": {
        "git": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "head",
            "upstream",
            "headUpstreamMatch",
            "worktreeClean"
          ],
          "properties": {
          "head": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "upstream": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
            "headUpstreamMatch": {
              "const": true
            },
            "worktreeClean": {
              "const": false
            }
          }
        },
        "workflow": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pushTrigger",
            "pullRequestTrigger",
            "permissions",
            "credentialsPersisted",
            "exactHeadCheckout",
            "concurrencyCancellation",
            "trackedMutationRejected"
          ],
          "properties": {
            "pushTrigger": {
              "const": true
            },
            "pullRequestTrigger": {
              "const": true
            },
            "permissions": {
              "const": "contents-read"
            },
            "credentialsPersisted": {
              "const": false
            },
            "exactHeadCheckout": {
              "const": true
            },
            "concurrencyCancellation": {
              "const": true
            },
            "trackedMutationRejected": {
              "const": true
            }
          }
        },
        "signingPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cryptographicSignature",
            "dco",
            "historyRewrite",
            "forcePush"
          ],
          "properties": {
            "cryptographicSignature": {
              "const": true
            },
            "dco": {
              "const": true
            },
            "historyRewrite": {
              "const": false
            },
            "forcePush": {
              "const": false
            }
          }
        },
        "subjectAggregation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "subjects",
            "subjectDefinitive",
            "definitiveMissing",
            "openRequired",
            "unclassified",
            "gapInstances",
            "autoPromotion"
          ],
          "properties": {
            "subjects": {
              "const": 97
            },
            "subjectDefinitive": {
              "const": 0
            },
            "definitiveMissing": {
              "const": 97
            },
            "openRequired": {
              "const": 119
            },
            "unclassified": {
              "const": 90
            },
            "gapInstances": {
              "const": 388
            },
            "autoPromotion": {
              "const": false
            }
          }
        },
        "distribution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "ready",
            "blockerInstances"
          ],
          "properties": {
            "status": {
              "const": "not-established"
            },
            "ready": {
              "const": 0
            },
            "blockerInstances": {
              "const": 589
            }
          }
        },
        "root": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "missingArtifacts",
            "completionEffect"
          ],
          "properties": {
            "status": {
              "const": "root-definitive-incomplete"
            },
            "missingArtifacts": {
              "const": 5
            },
            "completionEffect": {
              "const": "none"
            }
          }
        },
        "dependencyGraph": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "recordedStatus",
            "recordedRequiredOutputs",
            "currentProof"
          ],
          "properties": {
            "recordedStatus": {
              "const": "current"
            },
            "recordedRequiredOutputs": {
              "const": 39
            },
            "currentProof": {
              "const": false
            }
          }
        },
        "ci": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "candidateCommit",
            "pushRun",
            "pullRequestRun",
            "sameShaVerified"
          ],
          "properties": {
            "candidateCommit": {
              "type": "null"
            },
            "pushRun": {
              "type": "null"
            },
            "pullRequestRun": {
              "type": "null"
            },
            "sameShaVerified": {
              "const": false
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prerequisites",
        "satisfied",
        "blocked",
        "checkpointReady",
        "completionEffect"
      ],
      "properties": {
        "prerequisites": {
          "const": 9
        },
        "satisfied": {
          "const": 3
        },
        "blocked": {
          "const": 6
        },
        "checkpointReady": {
          "const": false
        },
        "completionEffect": {
          "const": "none"
        }
      }
    },
    "prerequisites": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "$ref": "#/$defs/prerequisite"
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "readOnly",
        "autoCommit",
        "autoPush",
        "autoMerge",
        "autoPromotion",
        "dirtyTreeHasCiIdentity",
        "headUpstreamMatchIsCheckpoint",
        "sameShaRequired",
        "pushAndPullRequestSuccessRequired",
        "graphRerunRequired",
        "externalPublication",
        "completionEffect"
      ],
      "properties": {
        "readOnly": {
          "const": true
        },
        "autoCommit": {
          "const": false
        },
        "autoPush": {
          "const": false
        },
        "autoMerge": {
          "const": false
        },
        "autoPromotion": {
          "const": false
        },
        "dirtyTreeHasCiIdentity": {
          "const": false
        },
        "headUpstreamMatchIsCheckpoint": {
          "const": false
        },
        "sameShaRequired": {
          "const": true
        },
        "pushAndPullRequestSuccessRequired": {
          "const": true
        },
        "graphRerunRequired": {
          "const": true
        },
        "externalPublication": {
          "const": false
        },
        "completionEffect": {
          "const": "none"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "digest"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "prerequisite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "state",
        "evidence",
        "gapIds"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "state": {
          "enum": [
            "satisfied",
            "blocked"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "gapIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
